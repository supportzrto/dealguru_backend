# Copy this file to .env and paste your Railway PostgreSQL URL.
# Railway may provide postgresql://; the app normalizes it for psycopg.

APP_ENV=development

# --- Production on Railway (frontend on Vercel = different site) ---
# Cookie must be SameSite=None + Secure to be sent cross-site.
COOKIE_SECURE=true
COOKIE_SAMESITE=none
# Railway start command (so redirects/cookies see https):
# uvicorn app.main:app --host 0.0.0.0 --port $PORT --proxy-headers --forwarded-allow-ips="*"